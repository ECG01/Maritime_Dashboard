# Per-machine settings for the CariCOOS Maritime Dashboard. Copy to config/machine.env.

# Root of the clone (code, data/, state/, logs/, web/out/ live here)
#   PROD (dm2):
BASE_DIR="/mnt/data1/mediatemple/Maritime_Dashboard"
#   DEV (WSL):
# BASE_DIR="/mnt/c/Users/edwar/Downloads/JUN_JULY_PRODUCTS/Maritime_Dashboard"

# Phase 1 needs only numpy/pandas/pyarrow/netCDF4, which the shared mesonet-ops venv
# already has - so no venv owned by another project has to be modified.
#   PROD (dm2): the mesonet-ops venv
PYTHON="/mnt/data1/mediatemple/Mesonet_ECG/mesonet-ops/.meso_env/bin/python"
#   DEV (WSL):
# PYTHON="$HOME/venvs/meson_env/bin/python"

THREDDS_BASE="https://dm1.caricoos.org/thredds"

# api.weather.gov REJECTS requests without a descriptive User-Agent. Put a real
# contact address here - NWS uses it to reach you if a query misbehaves.
NWS_API="https://api.weather.gov"
NWS_USER_AGENT="CariCOOS Maritime Dashboard (dm2.caricoos.org; ops@caricoos.org)"
NWS_CWF_OFFICE="SJU"

COOPS_API="https://api.tidesandcurrents.noaa.gov/api/prod/datagetter"
NDBC_LATEST="https://www.ndbc.noaa.gov/data/latest_obs/latest_obs.txt"

# Public web folder the wrappers rsync web/out/ into. Empty disables publishing,
# which is what you want on a dev machine.
#   PROD (dm2):
DASHBOARD_WEBROOT="/mnt/data1/mediatemple/htdocs/httpdocs/Maritime_Dashboard"
#   DEV (WSL):
# DASHBOARD_WEBROOT=""
HUB_URL="https://dm2.caricoos.org/Maritime_Dashboard"

# ABSOLUTE https on purpose, for all four.
# Relative URLs ("../Buoys_Dashboard/") only resolve when this hub is served from
# the same folder level on dm2. Anywhere else - a dev server, a staging host, a
# preview - they 404, and the embedded tool silently does nothing. All four hosts
# were verified to answer over https and to send no X-Frame-Options or
# frame-ancestors CSP, so absolute https works everywhere. (An https iframe
# inside an http page is allowed; only the reverse is blocked.)
BUOYS_HUB_URL="https://dm2.caricoos.org/Ocean_Buoys/"
MESONET_HUB_URL="https://dm2.caricoos.org/Wind_Stations/"
MODVIEWER_URL="https://modviewer.caricoos.org/"
CLASSIC_VIEWER_URL="http://dm2.caricoos.org/Model_Viewer_v1/"

# Chatbot. Empty = the Ask button is not rendered at all, which is the default:
# the dashboard must keep working with no chatbot deployed.
# The ACCESS KEY is deliberately NOT here. It would be readable by anyone who
# opened the page, which is the opposite of "internal only" - the panel asks each
# person for it once instead and keeps it in their browser.
CHAT_WORKER_URL=""

# Cloudflare Web Analytics. Empty = no script is emitted at all, which is the
# default: the dashboard must never depend on an analytics provider being up.
# Token comes from the Cloudflare dashboard -> Web Analytics -> your site.
# It counts PAGE VIEWS only - Cloudflare's own FAQ says custom events are "not
# yet" supported - so it cannot tell you which locations people open. That is
# what ANALYTICS_URL below is for.
CF_ANALYTICS_TOKEN=""

# Where in-page events go (which location expanded, which tool opened, language,
# units). Empty = nothing is sent and no listener is installed.
#   local testing:  http://127.0.0.1:8788/event
ANALYTICS_URL=""

# --- climatology (optional) -------------------------------------------------
# Roots of the two sibling hub projects, read DAILY for their already-computed
# climatology. Empty is the default: no climatology block is emitted and the
# chatbot answers that it has no historical data.
#
# Local files are preferred on every machine, dm2 included. The HTTP fallback
# gives only the day-of-year percentile bands - the monthly tables, the records
# and the period of record are in files the hubs do not publish - so a box with
# no local dirs answers "is today normal?" but not "what is January like?".
# On dm2, point these at the real roots and run:
#     $PYTHON fetch/fetch_climatology.py --dry-run
# and check every line says `local`.
BUOYS_OPS_DIR=""
MESONET_OPS_DIR=""
BUOYS_CLIMATE_URL="https://dm2.caricoos.org/Ocean_Buoys/plots/station_climate.html"
MESONET_CLIMATE_URL="https://dm2.caricoos.org/Wind_Stations/plots/station_climate.html"
